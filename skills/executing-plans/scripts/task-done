#!/usr/bin/env bash
# Close one task of an inline plan execution in a single call: run the task's
# test command, keep its full output in the workspace, print the tail, and —
# only if the command succeeded — append the completion line to the ledger.
# A failing command records nothing: the task is not complete.
#
# Usage: task-done PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]
#   BASE is the SHA task-start printed; the completion line records BASE..HEAD.
# Exit: the test command's exit status.
set -euo pipefail

if [ $# -lt 5 ]; then
  echo "usage: task-done PLAN_FILE TASK_NUMBER BASE --evidence WORKSPACE | --manual-evidence REPORT | -- LEGACY_COMMAND [ARGS...]" >&2
  exit 2
fi

plan=$1
n=$2
base=$3
mode=$4
shift 4
sdd="$(cd "$(dirname "$0")/../../subagent-driven-development/scripts" && pwd)"

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }

dir=$("${BASH:-bash}" "$sdd/sdd-workspace" "$plan")
log="$dir/task-${n}-tests.log"
ledger="$dir/progress.md"

if [ "$mode" = "--evidence" ]; then
  [ $# -eq 1 ] || { echo "--evidence requires WORKSPACE" >&2; exit 2; }
  verify="$sdd/../../using-superpowers/scripts/verify.mjs"
  result=$(node "$verify" complete "$1" "$n") || exit $?
  [ -f "$ledger" ] || printf '# 进度账本 — %s\n' "$plan" > "$ledger"
  printf 'Task %s: complete (commits %s..%s, evidence: %s/verification.json)\n' "$n" "$(git rev-parse --short=7 "$base")" "$(git rev-parse --short=7 HEAD)" "$1" >> "$ledger"
  printf '%s\n' "$result"
  exit 0
fi

if [ "$mode" = "--manual-evidence" ]; then
  [ $# -eq 1 ] && [ -s "$1" ] || { echo "缺少人工证据报告" >&2; exit 2; }
  # 人工核查不冒充脚本验证：明确保留核查范围、命令、结果与限制。
  grep -q '^Status: verified$' "$1" && grep -q '^Policy:' "$1" && grep -q '^Scope:' "$1" && grep -q '^Command:' "$1" && grep -q '^Result:' "$1" || { echo "人工报告缺少必需字段" >&2; exit 2; }
  [ -f "$ledger" ] || printf '# 进度账本 — %s\n' "$plan" > "$ledger"
  printf 'Task %s: complete (manual evidence: %s; validity checked by controller)\n' "$n" "$1" >> "$ledger"
  exit 0
fi

[ "$mode" = "--" ] || { echo "未知完成模式" >&2; exit 2; }
if grep -q 'verification-policy' "$plan" || [ -f "$dir/verification.json" ]; then
  echo "分级计划必须使用 --evidence 或 --manual-evidence，不能重复运行旧完成命令" >&2
  exit 2
fi

# Render the command the way a person would type it, for the ledger line.
cmd=""
for a in "$@"; do
  case "$a" in
    *[[:space:]\"\;\|\&]*) cmd="$cmd '$a'" ;;
    *) cmd="$cmd $a" ;;
  esac
done
cmd=${cmd# }

rc=0
"$@" > "$log" 2>&1 || rc=$?

tail -n 5 "$log"
if [ "$rc" -ne 0 ]; then
  echo "task-done: test command exited $rc; Task $n NOT recorded (full output: $log)" >&2
  exit "$rc"
fi

last=$(grep -v '^[[:space:]]*$' "$log" | tail -n 1)
[ -f "$ledger" ] || printf '# SDD ledger — plan: %s\n' "$plan" > "$ledger"
line="Task $n: complete (commits $(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 HEAD), tests: $cmd → $last)"
printf '%s\n' "$line" >> "$ledger"
echo "ledger: $line"
